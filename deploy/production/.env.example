# Copy to .env and fill in. Keep this file private.

# The domain users open; it must point at this host (ports 80 and 443).
AGENTHOLD_DOMAIN=agents.example.com

# GitHub OAuth app (docs/auth-github.md).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Master key for secrets at rest. Generate once with: openssl rand -base64 32
# Back it up: without it, stored secrets cannot be decrypted.
AGENTHOLD_MASTER_KEY=

# Cloudflare Tunnel instead of opening ports 80/443 (docs/install.md):
# COMPOSE_FILE=docker-compose.yml:docker-compose.cloudflared.yml
# CLOUDFLARE_TUNNEL_TOKEN=

# Images. Defaults: the published release images.
# AGENTHOLD_IMAGE=ghcr.io/gempir/agenthold:latest
# AGENTHOLD_BASE_IMAGE=ghcr.io/gempir/agenthold-base:latest
