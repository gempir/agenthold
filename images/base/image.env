# Environment of every process sandboxd starts in the guest (installed as /etc/agenthold/image.env).
# One KEY=VALUE per line, no quoting, no expansion. The per-boot environment from the host wins.
LANG=C.UTF-8
PATH=/home/agent/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CHROME_BIN=/usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_DOWNLOAD=1
# The image pins the Antigravity CLI; it must not update itself (agy in a terminal, too).
AGY_CLI_DISABLE_AUTO_UPDATE=true
# git never waits on an interactive credential prompt; it fails instead.
GIT_TERMINAL_PROMPT=0
