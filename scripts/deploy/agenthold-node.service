[Unit]
Description=agenthold edge node (dials its controller, runs its agents)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/opt/agenthold/current/agenthold node
Environment=AGENTHOLD_CONFIG=/etc/agenthold/node.yaml
WorkingDirectory=/
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillMode=process
Delegate=yes
UMask=0077

[Install]
WantedBy=multi-user.target
