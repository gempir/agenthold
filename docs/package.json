{
  "name": "agenthold-docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview",
    "typecheck": "bun --bun astro check",
    "lint:docs": "bun --bun nimbus-docs lint",
    "lint:docs:fix": "bun --bun nimbus-docs lint --fix",
    "prepreview:cf": "bun --bun astro build",
    "preview:cf": "bun --bun wrangler dev",
    "predeploy": "bun --bun astro check && bun --bun astro build",
    "deploy": "bun --bun wrangler deploy",
    "check": "bun --bun nimbus-docs check"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "^0.20.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/ph": "^1.2.2",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "7.4.2",
    "clsx": "^2.1.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "@scalar/openapi-parser": "0.28.12",
    "openapi-sampler": "1.7.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/language-server": "2.17.3",
    "@emnapi/runtime": "1.11.3",
    "@tailwindcss/vite": "^4.3.3",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.95.0"
  },
  "packageManager": "pnpm@11.7.0"
}
