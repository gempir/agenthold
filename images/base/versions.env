# Pinned inputs of the base image. Sourced (as shell) by scripts/guest/build-rootfs.sh,
# and provision.sh. Bump BASE_VERSION when anything here changes.
BASE_VERSION=2026.11.15-1

# Debian packages come from snapshot.debian.org at this timestamp, so a rebuild resolves exactly
# the same package versions. The image's own apt sources point at deb.debian.org afterwards.
DEBIAN_SUITE=trixie
DEBIAN_SNAPSHOT=20261110T000000Z

# Node.js official binaries (sha256 from https://nodejs.org/dist/vX/SHASUMS256.txt).
NODE_VERSION=24.22.3
NODE_SHA256_ARM64=6e51a2ada00f0011cc266f65d98922b403d7ad88f809ca2aa615a5fe1ce6e86c
NODE_SHA256_X64=4f2b175a6d53a5c617a80dba2676238a0688cef28c6da4eba35c7d844e66fcfb

# Harness ACP adapters (npm; the full graph is pinned in package-lock.json).
CLAUDE_AGENT_ACP_VERSION=0.107.0
OPENCODE_VERSION=1.19.5
CODEX_ACP_VERSION=2.6.0

# Debian's archive keyring, used to verify the snapshot (build hosts such as Ubuntu 24.04 ship one
# that predates trixie's signing keys). Same file as pool/main/d/debian-archive-keyring/ upstream.
DEBIAN_KEYRING_DEB=debian-archive-keyring_2025.1_all.deb
DEBIAN_KEYRING_SHA256=9ea7778e443144ca490668737a8ab22dd3e748bb99e805e22ec055abeb3c7fac
